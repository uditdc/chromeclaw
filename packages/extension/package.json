{
  "name": "@chromeclaw/extension",
  "description": "ChromeClaw browser extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
